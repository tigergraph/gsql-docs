CREATE QUERY print_member_activity() FOR GRAPH Social_Net
{
    SumAccum<INT> @activity_amount;
    start = {Person.*};

    /* --- equivalent statements -----
    result = SELECT v FROM (v:start) -[e]- (tgt:Post)
        ACCUM v.@activity_amount +=1
        HAVING true; */

    result = SELECT v FROM (v:start) -[e]- (tgt:Post)
        ACCUM v.@activity_amount +=1;

    PRINT result;
}