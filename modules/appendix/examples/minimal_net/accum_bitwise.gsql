CREATE QUERY bitwise_accum_ex(UINT len) FOR GRAPH Minimal_Net {
  BitwiseAndAccum @@bw_and;          // Regular fixed-length (64 bits)
  BitwiseOrAccum<80> @@bw_or_long;   // Long fixed-length
  BitwiseOrAccum<len> @@bw_or_dyn;   // Dynamic-length

  // Regular fixed-length
  @@bw_and += 170;  // 11111111 & 10101010 -> 10101010 (decimal 170)
  @@bw_and += 85;   // 10101010 & 01010101 -> 00000000 (decimal 0)
  PRINT @@bw_and;   // 0

  // Long fixed-length
  @@bw_or_long += 170;  // 80 bits: ...000 | ...10101010 -> ...10101010
  @@bw_or_long.clear(); // Free memory
  @@bw_or_long += 85;   // ...000 | ...01010101 -> ...01010101 (decimal 85)
  PRINT @@bw_or_long;   // 85

  // Dynamic-length (e.g., len = 8)
  @@bw_or_dyn += 170;   // 00000000 | 10101010 -> 10101010 (decimal 170)
  @@bw_or_dyn += 85;    // 10101010 | 01010101 -> 11111111 (decimal 255)
  PRINT @@bw_or_dyn;    // 255

  // @@bw_or_dyn.resize(len + 1); // Not supported
}